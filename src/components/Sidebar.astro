---
import { WidgetArea } from "emdash/ui";
---

<aside class="sidebar">
  <div class="sidebar-sticky">
    <div class="sidebar-section">
      <h3 class="sidebar-title">DISCOVER</h3>
      <WidgetArea name="sidebar" />
    </div>

    <div class="sidebar-promo">
      <h3 class="promo-title">STAY UPDATED</h3>
      <p>Join our brutalist newsletter for more raw updates and AI insights.</p>
      <div class="promo-form">
        <input type="email" placeholder="YOUR@EMAIL.COM" aria-label="Email" />
        <button type="button">SUBSCRIBE</button>
      </div>
    </div>
    
    <div class="sidebar-section social-links">
      <h3 class="sidebar-title">CONNECT</h3>
      <div class="social-grid">
        <a href="#">TWITTER</a>
        <a href="#">GITHUB</a>
        <a href="#">RSS</a>
      </div>
    </div>
  </div>
</aside>
