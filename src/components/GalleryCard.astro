---
interface Term {
	slug: string;
	label: string;
}

interface Props {
	gallery: any;
	categories?: Term[];
	districts?: Term[];
}

const { gallery, categories = [], districts = [] } = Astro.props;
---

<li class="post-card" data-districts={districts.map((d) => d.slug).join(" ")}>
	<a href={`/galerie/${gallery.id}`}>
		<div class="content">
			<div class="post-card-tags">
				{
					districts.map((d) => (
						<span class="tag-chip">
							{d.label}
						</span>
					))
				}
				{
					categories.map((c) => (
						<span class="tag-chip">
							{c.label}
						</span>
					))
				}
			</div>

			<h2>{gallery.data.title}</h2>
			
			<p class="address">
				📍 {gallery.data.address}
			</p>

			{
				gallery.data.note && (
					<p class="note">
						{gallery.data.note.length > 150 ? gallery.data.note.substring(0, 147) + '...' : gallery.data.note}
					</p>
				)
			}
			
			<div class="card-footer">
				<span>DETAIL GALERIE</span>
				<span>&rarr;</span>
			</div>
		</div>
	</a>
</li>

<style>
	.post-card > a {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.content {
		flex-grow: 1;
		display: flex;
		flex-direction: column;
	}

	.address {
		font-family: var(--font-mono), monospace;
		font-size: 0.8rem;
		margin-bottom: 1rem;
		color: var(--muted-color);
	}

	.note {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--muted-color);
		flex-grow: 1;
		margin: 0 0 1.5rem 0;
	}

	.card-footer {
		margin-top: auto;
		font-family: var(--font-body), sans-serif;
		font-weight: 600;
		text-transform: uppercase;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		border-top: 1px solid var(--border-color);
		padding-top: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		color: var(--text-color);
	}
</style>
