---
import { Image as EmdashImage } from "emdash/ui";

interface Props {
	image?: any;
	class?: string;
	[key: string]: any;
}

const { image, class: className, ...rest } = Astro.props;

const fallbackImage = {
	id: "fallback",
	src: "/placeholder.png",
	alt: "Image not found",
};

const finalImage = image?.src ? image : fallbackImage;
---

<EmdashImage 
	image={finalImage} 
	class={className} 
	{...rest} 
	onerror="this.src='/placeholder.png'; this.onerror=null;"
/>
