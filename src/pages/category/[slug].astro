---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import Sidebar from "../../components/Sidebar.astro";
import { plural } from "../../utils/format";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);
---

<Base title={`Kategorie: ${term.label}`} description={`Články v kategorii ${term.label}`}>
	<div class="with-sidebar">
		<div>
			<div style="margin-bottom: 4rem;">
				<h1 class="page-heading page-heading--yellow" style="margin-bottom: 0.5rem;">KATEGORIE: {term.label.toUpperCase()}</h1>
				<div class="result-count">{posts.length} {plural(posts.length, "záznam", "záznamy", "záznamů")}</div>
			</div>

			<PostList posts={posts} emptyText="V této kategorii zatím nejsou žádné články." />
		</div>
		<Sidebar />
	</div>
</Base>
