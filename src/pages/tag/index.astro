---
import { getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";

const tags = await getTaxonomyTerms("tag");
---

<Base title="Štítky">
	<h1 class="page-heading page-heading--magenta" style="margin-bottom: 3rem;">MRAK ŠTÍTKŮ</h1>

	<div class="block" style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: center; padding: 3rem;">
		{tags.map((tag) => (
			<a 
				href={`/tag/${tag.slug}`} 
				style={`
					font-size: ${1 + (tag.count * 0.2)}rem;
					background: var(--accent-1);
					padding: 0.5rem 1rem;
					border: 2px solid #000;
					box-shadow: 4px 4px 0px #000;
					text-transform: uppercase;
					font-weight: 900;
				`}
			>
				{tag.label} ({tag.count})
			</a>
		))}

		{tags.length === 0 && (
			<p>Žádné štítky nenalezeny.</p>
		)}
	</div>
</Base>
