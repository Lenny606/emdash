---
import { getTaxonomyTerms } from "emdash";
import Base from "../../layouts/Base.astro";

const tags = await getTaxonomyTerms("tag");
---

<Base title="Tags">
	<h1 style="background: var(--accent-3); color: #fff; display: inline-block; padding: 0.5rem 1.5rem; border: var(--border-width) solid var(--border-color); box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color); margin-bottom: 3rem;">TAG CLOUD</h1>

	<div class="block" style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: center; padding: 3rem;">
		{tags.map((tag) => (
			<a 
				href={`/tag/${tag.slug}`} 
				style={`
					font-size: ${1 + (tag.count * 0.2)}rem;
					background: var(--accent-1);
					padding: 0.5rem 1rem;
					border: 2px solid #000;
					box-shadow: 4px 4px 0px #000;
					text-transform: uppercase;
					font-weight: 900;
				`}
			>
				{tag.label} ({tag.count})
			</a>
		))}

		{tags.length === 0 && (
			<p>No tags detected in this sector.</p>
		)}
	</div>
</Base>
