---
import { getTerm, getEmDashCollection, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { plural } from "../../utils/format";

const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("tag", slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
});
Astro.cache.set(cacheHint);
---

<Base title={`Štítek: ${term.label}`} description={`Články se štítkem ${term.label}`}>
	<div style="margin-bottom: 4rem;">
		<h1 class="page-heading page-heading--magenta" style="margin-bottom: 0.5rem;">ŠTÍTEK: {term.label.toUpperCase()}</h1>
		<div class="result-count">{posts.length} {plural(posts.length, "záznam", "záznamy", "záznamů")}</div>
	</div>

	<PostList posts={posts} emptyText="Se štítkem zatím nejsou žádné články." />
</Base>
