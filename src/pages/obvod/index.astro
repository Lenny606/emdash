---
import { getTaxonomyTerms, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const districts = await getTaxonomyTerms("district");
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// Sort districts numerically, e.g. Praha 1, Praha 2, ..., Praha 10
const sortedDistricts = districts.toSorted((a, b) => {
	const numA = parseInt(a.label.replace(/\D/g, ""), 10);
	const numB = parseInt(b.label.replace(/\D/g, ""), 10);
	if (!isNaN(numA) && !isNaN(numB)) {
		return numA - numB;
	}
	return a.label.localeCompare(b.label, "cs");
});

function getDistrictCountLabel(count: number) {
	if (count === 1) return "galerie";
	if (count >= 2 && count <= 4) return "galerie";
	return "galerií";
}
---

<Base title={`Městské obvody | ${siteTitle}`} description="Přehled pražských obvodů s galeriemi.">
	<div class="with-sidebar">
		<div>
			<h1 class="page-heading">Městské obvody</h1>
			
			<div class="block">
				{sortedDistricts.length === 0 ? (
					<p>Nebyly nalezeny žádné městské obvody.</p>
				) : (
					<ul class="district-grid">
						{sortedDistricts.map((d) => (
							<li class="district-item">
								<a href={`/obvod/${d.slug}`} class="district-link">
									<div class="district-name">{d.label}</div>
									<div class="district-count">
										{d.count} {getDistrictCountLabel(d.count)}
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</div>
		</div>

		<Sidebar />
	</div>
</Base>

<style>
	.district-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 1.5rem;
		padding: 0;
		margin: 0;
	}

	.district-item {
		border: 1px solid var(--border-color);
		background-color: var(--bg-color);
		text-align: center;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.district-item:hover {
		background-color: var(--border-primary);
		border-color: var(--border-primary);
	}

	.district-link {
		display: block;
		padding: 2rem 1rem;
		text-transform: uppercase;
		height: 100%;
	}

	.district-item:hover .district-link {
		color: var(--bg-color);
	}

	.district-name {
		font-family: var(--font-heading);
		font-size: 1.4rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
	}

	.district-count {
		font-family: var(--font-body);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--muted-color);
	}

	.district-item:hover .district-count {
		color: var(--bg-color);
		opacity: 0.8;
	}
</style>
