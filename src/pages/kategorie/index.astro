---
import { getTaxonomyTerms, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const categories = await getTaxonomyTerms("gallery_category");
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
---

<Base title={`Kategorie | ${siteTitle}`} description="Přehled kategorií pražských galerií.">
	<div class="with-sidebar">
		<div>
			<h1 class="page-heading">Kategorie galerií</h1>
			
			<div class="block">
				{categories.length === 0 ? (
					<p>Nebyly nalezeny žádné kategorie.</p>
				) : (
					<ul class="category-list">
						{categories.map((cat) => (
							<li class="category-item">
								<a href={`/kategorie/${cat.slug}`} class="category-link">
									{cat.label} <span class="category-count">({cat.count})</span>
								</a>
								
								{cat.children && cat.children.length > 0 && (
									<ul class="subcategory-list">
										{cat.children.map((subcat) => (
											<li class="subcategory-item">
												<a href={`/kategorie/${subcat.slug}`} class="subcategory-link">
													{subcat.label} <span class="category-count">({subcat.count})</span>
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						))}
					</ul>
				)}
			</div>
		</div>

		<Sidebar />
	</div>
</Base>

<style>
	.category-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding: 0;
		margin: 0;
	}

	.category-item {
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 2rem;
	}

	.category-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.category-link {
		font-family: var(--font-heading), serif;
		font-size: 1.75rem;
		text-transform: uppercase;
		color: var(--text-color);
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.category-link:hover {
		opacity: 0.7;
	}

	.category-count {
		font-family: var(--font-body), sans-serif;
		font-size: 0.9rem;
		color: var(--muted-color);
		font-weight: 400;
	}

	.subcategory-list {
		margin-top: 1.5rem;
		margin-left: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border-left: 1px solid var(--border-color);
		padding-left: 1.5rem;
		list-style: none;
	}

	.subcategory-link {
		font-family: var(--font-body), sans-serif;
		font-size: 1rem;
		text-transform: uppercase;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--text-color);
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
	}

	.subcategory-link:hover {
		opacity: 0.7;
	}
</style>
