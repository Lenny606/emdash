---
// Prestige Beauty Salon — redesign reproduction of the Stitch screen,
// wired with real content extracted from prestigebeautysalon.cz.
// Content source: content/prestige-home.md
//
// Images are hot-linked from the live site's CDN — for production, download
// them and upload to EmDash media instead of referencing externally.

const CDN = "https://cbcde18247.clvaw-cdnwnd.com/7dc52aed9bef38085303530badf91f8e";

const brand = {
	name: "Prestige",
	sub: "Beauty Salon",
	tagline: "Prémiový salón krásy v srdci Prahy",
	slogan: "Dokonalost v každém detailu",
	hero: `${CDN}/200000455-902c3902c4/pano_zoom.jpeg?ph=cbcde18247`,
};

const sideNav = ["Úvod", "Ošetření", "Renasculpt", "Biohack", "Brow & Lash", "Kontakt"];

// Featured strip — 4 editorial service shots
const strip = [
	{ src: `${CDN}/200000022-3334f33352/Osetrenie_PEELING.jpeg?ph=cbcde18247`, alt: "Ošetření pleti Institut Esthederm", tall: false },
	{ src: `${CDN}/200000066-d0fbbd0fbd/idenel05-1024x1007.jpeg?ph=cbcde18247`, alt: "Ošetření Idenel s mikrojehličkami", tall: true },
	{ src: `${CDN}/200000020-8928789288/no1.jpeg?ph=cbcde18247`, alt: "Ošetření Di Angelo", tall: false },
	{ src: `${CDN}/200000040-0b1bb0b1bd/rifetechplasma-745x1024.jpeg?ph=cbcde18247`, alt: "Biohack systém", tall: true },
];

const categories = ["Ošetření pleti", "Renasculpt", "Maderoterapie", "Biohack", "Brow & Lash"];

// Full service grid (PEPTAXEL is featured separately below)
const services = [
	{ title: "Ošetření pleti Institut Esthederm", desc: "Tréninkem, který učí pleť fungovat vlastními silami.", src: `${CDN}/200000022-3334f33352/Osetrenie_PEELING.jpeg?ph=cbcde18247` },
	{ title: "Idenel s mikrojehličkami", desc: "Korejská metoda microneedlingu pro obnovu a pevnost pleti.", src: `${CDN}/200000066-d0fbbd0fbd/idenel05-1024x1007.jpeg?ph=cbcde18247` },
	{ title: "Autobiography Photon Pro", desc: "Multifunkční věž: mikrodermabraze, mezoterapie a LED fototerapie.", src: `${CDN}/200000075-b5713b5714/Sn%C3%ADmek%20obrazovky%202026-01-13%20v%C2%A012.02.20.png?ph=cbcde18247` },
	{ title: "Ošetření Di Angelo", desc: "Česká luxusní kosmetika pro náročnou pleť.", src: `${CDN}/200000020-8928789288/no1.jpeg?ph=cbcde18247` },
	{ title: "Přístrojová maderoterapie", desc: "Přístrojové ošetření celulitidy a formování postavy.", src: `${CDN}/200000026-d1bd9d1bdb/1176.jpeg?ph=cbcde18247` },
	{ title: "Renasculpt procedury", desc: "Tvarování postavy technologií EMS.", src: `${CDN}/200000028-e4c2fe4c31/d112a7_08f5ae69062c4ea385cf741ff5dffd9c~mv2.png?ph=cbcde18247` },
	{ title: "Biohack systém", desc: "Plazmová a frekvenční terapie pro regeneraci.", src: `${CDN}/200000040-0b1bb0b1bd/rifetechplasma-745x1024.jpeg?ph=cbcde18247` },
	{ title: "Brow & Lash Bar", desc: "Profesionální péče o obočí a řasy.", src: `${CDN}/200000046-00ba800baa/eyebrows-and-lashes-185.png?ph=cbcde18247` },
];

const peptaxel = {
	image: `${CDN}/200000231-1240b1240d/Sn%C3%ADmek-0Aobrazovky%202026-02-03%20v%C2%A020.00.08.png?ph=cbcde18247`,
	priceRegular: "3 700 Kč",
	pricePackage: "7 400 Kč",
	saving: "3 700 Kč",
};

const contact = {
	name: "Prestige Beauty Salon",
	address: "Husitská 106/1, 130 00 Praha 3-Žižkov",
	phone: "+420 799 022 333",
	phoneHref: "+420799022333",
	email: "info@prestigebeautysalon.cz",
	hours: "Po–Pá 9:00–20:00 · So–Ne dle objednávek",
};
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Prestige Beauty Salon — Prémiový salón krásy v srdci Prahy</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=Archivo:wght@600..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!-- ===== HERO ===== -->
		<header class="hero">
			<nav class="side-nav" aria-label="Hlavní navigace">
				<ul>
					{sideNav.map((item) => <li><a href="#">{item}</a></li>)}
				</ul>
			</nav>

			<figure class="hero-portrait">
				<img src={brand.hero} alt="Interiér salonu Prestige Beauty" loading="eager" />
			</figure>

			<div class="hero-brand">
				<p class="hero-brand__slogan">{brand.slogan}</p>
				<h1>{brand.name}</h1>
				<p class="hero-brand__sub">{brand.sub}</p>
				<p class="hero-brand__tag">{brand.tagline}</p>
				<a href="#sluzby" class="hero-brand__cta">Rezervovat si svou službu</a>
			</div>
		</header>

		<!-- ===== EDITORIAL GALLERY STRIP ===== -->
		<section class="strip" aria-label="Galerie ošetření">
			{
				strip.map((g) => (
					<figure class={g.tall ? "strip__item strip__item--tall" : "strip__item"}>
						<img src={g.src} alt={g.alt} loading="lazy" />
						<figcaption>{g.alt}</figcaption>
					</figure>
				))
			}
		</section>

		<nav class="categories" aria-label="Kategorie">
			{categories.map((c) => <a href="#sluzby" class="categories__item">{c}</a>)}
		</nav>

		<!-- ===== SERVICES GRID ===== -->
		<section class="services" id="sluzby">
			<header class="services__head">
				<h2>Naše ošetření</h2>
				<p>Individuální přístup, profesionální péče a přirozená krása.</p>
			</header>
			<div class="services__grid">
				{
					services.map((s) => (
						<article class="card">
							<div class="card__media">
								<img src={s.src} alt={s.title} loading="lazy" />
							</div>
							<h3 class="card__title">{s.title}</h3>
							<p class="card__desc">{s.desc}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- ===== NEON FEATURE: PEPTAXEL ===== -->
		<section class="feature">
			<div class="feature__glow" aria-hidden="true"></div>
			<div class="feature__inner">
				<p class="feature__eyebrow">Akční nabídka — 3 ošetření za cenu 2</p>
				<h2 class="feature__title">
					Peptaxel: <span>Přírodní</span> mikrojehličkování s peptidy
				</h2>
				<p class="feature__lead">
					Mikrojehličkování s mořskou houbou a peptidy pro viditelně mladší,
					pevnější a rozjasněnou pleť.
				</p>
				<dl class="feature__price">
					<div><dt>Běžná cena</dt><dd class="is-strike">{peptaxel.priceRegular}</dd></div>
					<div><dt>Balíček 3 ošetření</dt><dd class="is-accent">{peptaxel.pricePackage}</dd></div>
					<div><dt>Ušetříte</dt><dd>{peptaxel.saving}</dd></div>
				</dl>
				<a href="#" class="feature__cta">Chci využít akční nabídku</a>
			</div>
			<figure class="feature__media">
				<img src={peptaxel.image} alt="PEPTAXEL ošetření" loading="lazy" />
			</figure>
		</section>

		<!-- ===== FOOTER ===== -->
		<footer class="site-footer">
			<div class="site-footer__col">
				<span class="site-footer__name">{contact.name}</span>
				<span class="site-footer__hours">{contact.hours}</span>
			</div>
			<address class="site-footer__col">
				<span>{contact.address}</span>
				<a href={`mailto:${contact.email}`}>{contact.email}</a>
			</address>
			<a class="site-footer__phone" href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
		</footer>

		<style>
			:root {
				--ink: #111111;
				--paper: #ffffff;
				--gold: #c6a02c;
				--muted: #6b6b6b;
				--serif: "Bodoni Moda", Georgia, serif;
				--sans: "Hanken Grotesk", system-ui, sans-serif;
				--cond: "Archivo", "Hanken Grotesk", sans-serif;
			}

			* { box-sizing: border-box; margin: 0; padding: 0; }
			body {
				background: var(--paper);
				color: var(--ink);
				font-family: var(--sans);
				-webkit-font-smoothing: antialiased;
			}
			img { display: block; width: 100%; height: 100%; object-fit: cover; }

			/* ---------- HERO ---------- */
			.hero {
				display: grid;
				grid-template-columns: 48px 1fr 1fr;
				min-height: clamp(440px, 60vw, 680px);
			}
			.side-nav {
				border-right: 1px solid var(--ink);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.side-nav ul {
				list-style: none;
				writing-mode: vertical-rl;
				transform: rotate(180deg);
				display: flex;
				gap: 1.6rem;
			}
			.side-nav a {
				font-size: 0.68rem;
				font-weight: 600;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: var(--ink);
				text-decoration: none;
			}
			.side-nav a:hover { color: var(--gold); }

			.hero-portrait { overflow: hidden; background: #ddd; }
			.hero-portrait img { filter: grayscale(1) contrast(1.05); }

			.hero-brand {
				background: var(--gold);
				color: var(--ink);
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: clamp(1.5rem, 5vw, 4rem);
			}
			.hero-brand__slogan {
				font-family: var(--sans);
				text-transform: uppercase;
				letter-spacing: 0.28em;
				font-size: 0.7rem;
				font-weight: 600;
				margin-bottom: 1.4rem;
			}
			.hero-brand h1 {
				font-family: var(--serif);
				font-weight: 500;
				font-size: clamp(3rem, 9vw, 7rem);
				line-height: 0.9;
				letter-spacing: -0.01em;
			}
			.hero-brand__sub {
				font-family: var(--serif);
				font-size: clamp(1rem, 2.4vw, 1.7rem);
				letter-spacing: 0.5em;
				text-transform: uppercase;
				margin-top: 0.6rem;
			}
			.hero-brand__tag {
				font-family: var(--serif);
				font-style: italic;
				font-size: clamp(0.95rem, 1.6vw, 1.25rem);
				margin-top: 1.2rem;
				opacity: 0.85;
			}
			.hero-brand__cta {
				align-self: flex-start;
				margin-top: 2rem;
				padding: 0.8rem 1.8rem;
				border: 1px solid var(--ink);
				color: var(--ink);
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-size: 0.72rem;
				text-decoration: none;
				transition: background 0.2s ease, color 0.2s ease;
			}
			.hero-brand__cta:hover { background: var(--ink); color: var(--gold); }

			/* ---------- GALLERY STRIP ---------- */
			.strip {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				align-items: start;
			}
			.strip__item {
				position: relative;
				aspect-ratio: 3 / 3.4;
				overflow: hidden;
				background: #ccc;
			}
			.strip__item--tall { aspect-ratio: 3 / 4.2; }
			.strip__item img {
				filter: grayscale(1);
				transition: filter 0.4s ease, transform 0.6s ease;
			}
			.strip__item:hover img { filter: grayscale(0); transform: scale(1.04); }
			.strip__item figcaption {
				position: absolute;
				left: 0; right: 0; bottom: 0;
				padding: 0.6rem 0.8rem;
				font-size: 0.72rem;
				letter-spacing: 0.04em;
				color: #fff;
				background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			.strip__item:hover figcaption { opacity: 1; }

			.categories {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-around;
				gap: 1rem 2rem;
				padding: 1.6rem clamp(1rem, 4vw, 3rem);
				border-top: 1px solid var(--ink);
				border-bottom: 1px solid var(--ink);
			}
			.categories__item {
				font-family: var(--serif);
				font-size: clamp(1rem, 2vw, 1.5rem);
				color: var(--ink);
				text-decoration: none;
			}
			.categories__item:hover { color: var(--gold); }

			/* ---------- SERVICES ---------- */
			.services { padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 6vw, 5rem); }
			.services__head { text-align: center; max-width: 50ch; margin: 0 auto 3rem; }
			.services__head h2 {
				font-family: var(--serif);
				font-weight: 500;
				font-size: clamp(2rem, 5vw, 3.4rem);
			}
			.services__head p { color: var(--muted); margin-top: 0.8rem; }
			.services__grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: clamp(1.5rem, 3vw, 2.5rem);
			}
			.card__media {
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: #eee;
				margin-bottom: 1rem;
			}
			.card__media img {
				filter: grayscale(0.3);
				transition: filter 0.4s ease, transform 0.6s ease;
			}
			.card:hover .card__media img { filter: grayscale(0); transform: scale(1.05); }
			.card__title {
				font-family: var(--serif);
				font-weight: 500;
				font-size: 1.25rem;
				margin-bottom: 0.4rem;
			}
			.card__desc { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }

			/* ---------- NEON FEATURE ---------- */
			.feature {
				position: relative;
				display: grid;
				grid-template-columns: 1.1fr 0.9fr;
				gap: clamp(2rem, 5vw, 4rem);
				align-items: center;
				background: #050505;
				color: #fff;
				overflow: hidden;
				padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 6vw, 5rem);
			}
			.feature__glow {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(60% 50% at 12% 20%, rgba(0, 229, 255, 0.32), transparent 60%),
					radial-gradient(55% 60% at 88% 80%, rgba(255, 0, 200, 0.38), transparent 60%);
				filter: blur(8px);
			}
			.feature__inner { position: relative; }
			.feature__eyebrow {
				text-transform: uppercase;
				letter-spacing: 0.24em;
				font-size: 0.72rem;
				font-weight: 600;
				color: #00e5ff;
				margin-bottom: 1.2rem;
			}
			.feature__title {
				font-family: var(--cond);
				font-weight: 800;
				text-transform: uppercase;
				font-size: clamp(2.2rem, 6vw, 4.6rem);
				line-height: 0.92;
				letter-spacing: -0.01em;
			}
			.feature__title span { color: #ff2fce; }
			.feature__lead {
				font-size: clamp(1rem, 1.4vw, 1.15rem);
				line-height: 1.6;
				color: #cfcfcf;
				margin-top: 1.6rem;
				max-width: 48ch;
			}
			.feature__price {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				margin-top: 2rem;
			}
			.feature__price dt {
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: #9a9a9a;
				margin-bottom: 0.3rem;
			}
			.feature__price dd { font-family: var(--serif); font-size: 1.6rem; }
			.feature__price .is-strike { text-decoration: line-through; color: #9a9a9a; }
			.feature__price .is-accent { color: #ff2fce; }
			.feature__cta {
				display: inline-block;
				margin-top: 2.2rem;
				padding: 0.85rem 2.2rem;
				border: 1px solid #fff;
				color: #fff;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-size: 0.8rem;
				text-decoration: none;
				transition: background 0.2s ease, color 0.2s ease;
			}
			.feature__cta:hover { background: #fff; color: #050505; }
			.feature__media {
				position: relative;
				aspect-ratio: 4 / 5;
				overflow: hidden;
				border-radius: 4px;
				box-shadow: 0 0 50px rgba(255, 47, 206, 0.3);
			}

			/* ---------- FOOTER ---------- */
			.site-footer {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				align-items: center;
				gap: 1rem 2rem;
				padding: 1.6rem clamp(1.5rem, 5vw, 4rem);
				font-size: 0.82rem;
				border-top: 1px solid var(--ink);
			}
			.site-footer__col { display: flex; flex-direction: column; gap: 0.2rem; font-style: normal; }
			.site-footer__name { font-weight: 600; }
			.site-footer__hours, .site-footer__col span { color: var(--muted); }
			.site-footer__col a { color: var(--ink); text-decoration: none; }
			.site-footer__col a:hover { color: var(--gold); }
			.site-footer__phone {
				font-family: var(--serif);
				font-size: 1.4rem;
				color: var(--ink);
				text-decoration: none;
			}
			.site-footer__phone:hover { color: var(--gold); }

			/* ---------- RESPONSIVE ---------- */
			@media (max-width: 860px) {
				.feature { grid-template-columns: 1fr; }
				.feature__media { aspect-ratio: 16 / 9; }
			}
			@media (max-width: 760px) {
				.hero {
					grid-template-columns: 36px 1fr;
					grid-template-rows: auto auto;
				}
				.hero-portrait { grid-column: 2; min-height: 320px; }
				.hero-brand { grid-column: 1 / -1; }
				.side-nav { grid-row: 1; }
				.strip { grid-template-columns: repeat(2, 1fr); }
				.strip__item, .strip__item--tall { aspect-ratio: 3 / 3.6; }
			}
		</style>
	</body>
</html>
