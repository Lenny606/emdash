---
import Base from "../layouts/Base.astro";
---

<Base title="404 / NOT FOUND">
	<div class="block" style="text-align: center; background: #000; color: var(--accent-3); padding: 5rem 2rem;">
		<h1 style="font-size: 8rem; margin: 0; color: #fff;">404</h1>
		<h2 style="margin-bottom: 2rem;">PAGE DESTROYED OR NEVER EXISTED</h2>
		<p style="font-size: 1.5rem; margin-bottom: 3rem; color: #fff;">THE RESOURCE YOU ARE LOOKING FOR IS GONE.</p>
		<a href="/" style="background: var(--accent-2); color: #000; padding: 1rem 2rem; border: 3px solid #fff; box-shadow: 6px 6px 0px var(--accent-3);">RETURN TO REALITY</a>
	</div>
</Base>
