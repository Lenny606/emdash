---
import { search } from "emdash";
import Base from "../layouts/Base.astro";
import { plural } from "../utils/format";

const query = Astro.url.searchParams.get("q") || "";
let results = [];

if (query) {
	const searchResponse = await search(query, {
		collections: ["galleries", "pages"],
		status: "published",
		limit: 20,
	});
	results = searchResponse?.items ?? [];
}
const total = results.length;
---

<Base title={`Hledání: ${query || "..."}`} noindex>
	<div style="margin-bottom: 4rem;">
		<h1 class="page-heading page-heading--yellow" style="margin-bottom: 1rem;">VÝSLEDKY HLEDÁNÍ</h1>
		<form action="/search" method="GET" style="display: flex; gap: 1rem; max-width: 600px;">
			<input
				type="text"
				name="q"
				value={query}
				placeholder="ZADEJTE DOTAZ..."
				style="flex-grow: 1; background: #fff; font-weight: 900; text-transform: uppercase;"
			/>
			<button type="submit">HLEDAT</button>
		</form>
	</div>

	{query ? (
		<div>
			<p class="result-count" style="margin-bottom: 2rem;">
				NALEZENO {total} {plural(total, "VÝSLEDEK", "VÝSLEDKY", "VÝSLEDKŮ")} PRO "{query.toUpperCase()}"
			</p>
			
			<div class="post-list">
				{results.map((result) => result && (
					<div class="post-card">
						<a href={result.collection === "galleries" ? `/galerie/${result.slug || result.id}` : `/${result.slug || result.id}`} style="display: block; height: 100%;">
							<div class="content">
								<span style="background: #000; color: #fff; padding: 0.1rem 0.5rem; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 1rem; display: inline-block;">
									{result.collection === "galleries" ? "Galerie" : "Stránka"}
								</span>
								<h2 style="font-size: 1.5rem;">{result.title}</h2>
								<div class="snippet" style="font-size: 0.9rem; line-height: 1.4;" set:html={result.snippet} />
								<div style="margin-top: 1.5rem; font-weight: 900; text-decoration: underline;">ZOBRAZIT &rarr;</div>
							</div>
						</a>
					</div>
				))}
			</div>

			{results.length === 0 && (
				<div class="block" style="background: var(--accent-3); color: #fff;">
					<p style="font-size: 1.5rem; font-weight: 900;">NIC NENALEZENO. ZKUSTE JINÁ KLÍČOVÁ SLOVA.</p>
				</div>
			)}
		</div>
	) : (
		<div class="block">
			<p style="font-size: 1.25rem;">Zadejte hledaný výraz výše a spusťte vyhledávání.</p>
		</div>
	)}
</Base>

<style is:global>
	.snippet mark {
		background: var(--accent-1);
		color: #000;
		font-weight: 900;
		padding: 0 0.2rem;
	}
</style>
