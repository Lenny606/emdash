---
import { search, getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import { plural } from "../utils/format";

const query = Astro.url.searchParams.get("q") || "";
let results = [];
let galleryByUlid = new Map();
let exhibitionByUlid = new Map();

const formatDate = (dateStr: string) => {
	const d = new Date(dateStr);
	return d.toLocaleDateString("cs-CZ", {
		day: "numeric",
		month: "numeric",
		year: "numeric",
	});
};

if (query) {
	const searchResponse = await search(query, {
		collections: ["galleries", "pages", "exhibitions"],
		status: "published",
		limit: 20,
	});
	results = searchResponse?.items ?? [];

	if (results.some((r) => r.collection === "exhibitions" || r.collection === "galleries")) {
		const { entries: allGalleries } = await getEmDashCollection("galleries", { status: "published" });
		const { entries: allExhibitions } = await getEmDashCollection("exhibitions", { status: "published" });

		galleryByUlid = new Map(allGalleries.map((g) => [g.data.id, g]));
		exhibitionByUlid = new Map(allExhibitions.map((e) => [e.data.id, e]));
	}
}
const total = results.length;
---

<Base title={`Hledání: ${query || "..."}`} noindex>
	<div class="search-header-container">
		<h1 class="page-heading">Výsledky hledání</h1>
		<form action="/search" method="GET" class="search-form">
			<input
				type="text"
				name="q"
				value={query}
				placeholder="ZADEJTE DOTAZ..."
			/>
			<button type="submit">HLEDAT</button>
		</form>
	</div>

	{query ? (
		<div>
			<p class="result-count">
				NALEZENO {total} {plural(total, "VÝSLEDEK", "VÝSLEDKY", "VÝSLEDKŮ")} PRO "{query.toUpperCase()}"
			</p>
			
			<div class="post-list">
				{results.map((result) => {
					if (!result) return null;

					let href = "";
					let typeLabel = "";

					if (result.collection === "galleries") {
						href = `/galerie/${result.slug || result.id}`;
						typeLabel = "Galerie";
					} else if (result.collection === "exhibitions") {
						const ex = exhibitionByUlid.get(result.id);
						const gallery = ex ? galleryByUlid.get(ex.data.gallery) : null;
						href = gallery ? `/galerie/${gallery.id}` : "#";
						typeLabel = "Výstava";
					} else {
						href = `/${result.slug || result.id}`;
						typeLabel = "Stránka";
					}

					return (
						<div class="post-card">
							<a href={href}>
								<div class="content">
									<div class="post-card-tags">
										<span class="tag-chip">
											{typeLabel}
										</span>
									</div>
									<h2>{result.title}</h2>
									{result.collection === "exhibitions" && (() => {
										const ex = exhibitionByUlid.get(result.id);
										if (!ex) return null;
										const gallery = galleryByUlid.get(ex.data.gallery);
										return (
											<div class="exhibition-meta">
												{gallery && <p class="exhibition-gallery">Galerie: {gallery.data.title}</p>}
												<p class="exhibition-dates">{formatDate(ex.data.start_date)} – {formatDate(ex.data.end_date)}</p>
											</div>
										);
									})()}
									<div class="snippet" set:html={result.snippet} />
									<div class="action-link">
										Zobrazit &rarr;
									</div>
								</div>
							</a>
						</div>
					);
				})}
			</div>

			{results.length === 0 && (
				<div class="block">
					<p class="search-message">Nebyl nalezen žádný výsledek pro váš dotaz. Zkuste prosím jiná klíčová slova.</p>
				</div>
			)}
		</div>
	) : (
		<div class="block">
			<p class="search-message">Zadejte hledaný výraz výše a spusťte vyhledávání.</p>
		</div>
	)}
</Base>

<style>
	.search-header-container {
		margin-bottom: 4rem;
	}

	.search-form {
		display: flex;
		gap: 1rem;
		max-width: 600px;
	}

	.search-form input {
		flex-grow: 1;
	}

	.result-count {
		margin-bottom: 2rem;
	}

	.post-card > a {
		display: block;
		height: 100%;
	}

	.search-message {
		font-family: var(--font-body), sans-serif;
		font-size: 1.1rem;
		color: var(--muted-color);
	}

	.snippet {
		font-family: var(--font-body), sans-serif;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted-color);
		margin-top: 0.5rem;
	}

	.action-link {
		margin-top: auto;
		padding-top: 1.5rem;
		font-family: var(--font-body), sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		text-decoration: underline;
	}

	.exhibition-meta {
		margin-top: 0.5rem;
		font-family: var(--font-body), sans-serif;
		font-size: 0.9rem;
		color: var(--muted-color);
	}

	.exhibition-gallery {
		margin: 0 0 0.25rem 0;
	}

	.exhibition-dates {
		font-family: var(--font-mono), monospace;
		font-size: 0.8rem;
		margin: 0;
	}
</style>

<style is:global>
	.snippet mark {
		background: var(--bg-secondary);
		border-bottom: 2px solid var(--border-primary);
		color: var(--text-color);
		font-weight: 700;
		padding: 0 0.1rem;
	}
</style>
