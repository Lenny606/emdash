---
import { search } from "emdash";
import Base from "../layouts/Base.astro";
import { plural } from "../utils/format";

const query = Astro.url.searchParams.get("q") || "";
let results = [];

if (query) {
	const searchResponse = await search(query, {
		collections: ["galleries", "pages"],
		status: "published",
		limit: 20,
	});
	results = searchResponse?.items ?? [];
}
const total = results.length;
---

<Base title={`Hledání: ${query || "..."}`} noindex>
	<div style="margin-bottom: 4rem;">
		<h1 class="page-heading">Výsledky hledání</h1>
		<form action="/search" method="GET" class="search-form">
			<input
				type="text"
				name="q"
				value={query}
				placeholder="ZADEJTE DOTAZ..."
			/>
			<button type="submit">HLEDAT</button>
		</form>
	</div>

	{query ? (
		<div>
			<p class="result-count" style="margin-bottom: 2rem;">
				NALEZENO {total} {plural(total, "VÝSLEDEK", "VÝSLEDKY", "VÝSLEDKŮ")} PRO "{query.toUpperCase()}"
			</p>
			
			<div class="post-list">
				{results.map((result) => result && (
					<div class="post-card">
						<a href={result.collection === "galleries" ? `/galerie/${result.slug || result.id}` : `/${result.slug || result.id}`} style="display: block; height: 100%;">
							<div class="content">
								<div class="post-card-tags">
									<span class="tag-chip">
										{result.collection === "galleries" ? "Galerie" : "Stránka"}
									</span>
								</div>
								<h2>{result.title}</h2>
								<div class="snippet" set:html={result.snippet} />
								<div class="action-link">
									Zobrazit &rarr;
								</div>
							</div>
						</a>
					</div>
				))}
			</div>

			{results.length === 0 && (
				<div class="block">
					<p style="font-family: var(--font-body), sans-serif; font-size: 1.1rem; color: var(--muted-color);">Nebyl nalezen žádný výsledek pro váš dotaz. Zkuste prosím jiná klíčová slova.</p>
				</div>
			)}
		</div>
	) : (
		<div class="block">
			<p style="font-family: var(--font-body), sans-serif; font-size: 1.1rem; color: var(--muted-color);">Zadejte hledaný výraz výše a spusťte vyhledávání.</p>
		</div>
	)}
</Base>

<style>
	.search-form {
		display: flex;
		gap: 1rem;
		max-width: 600px;
	}

	.search-form input {
		flex-grow: 1;
	}

	.snippet {
		font-family: var(--font-body), sans-serif;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted-color);
		margin-top: 0.5rem;
	}

	.action-link {
		margin-top: auto;
		padding-top: 1.5rem;
		font-family: var(--font-body), sans-serif;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		text-decoration: underline;
	}
</style>

<style is:global>
	.snippet mark {
		background: var(--bg-secondary);
		border-bottom: 2px solid var(--border-primary);
		color: var(--text-color);
		font-weight: 700;
		padding: 0 0.1rem;
	}
</style>
