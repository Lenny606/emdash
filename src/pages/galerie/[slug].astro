---
import { getEmDashEntry, getEntryTerms, getSeoMeta, decodeSlug, getSiteSettings, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: gallery, cacheHint } = await getEmDashEntry("galleries", slug);

if (!gallery) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(gallery, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/galerie/${slug}`,
});

const categories = await getEntryTerms("galleries", gallery.data.id as string, "gallery_category");
const districts = await getEntryTerms("galleries", gallery.data.id as string, "district");

// Fetch exhibitions and filter/sort them for this gallery
const { entries: allExhibitions, cacheHint: exhibitionsCacheHint } = await getEmDashCollection("exhibitions", {
	status: "published",
});
Astro.cache.set(exhibitionsCacheHint);

const galleryExhibitions = allExhibitions.filter((ex) => ex.data.gallery === gallery.data.id);

const now = new Date();
const currentAndUpcoming = galleryExhibitions
	.filter((ex) => new Date(ex.data.end_date) >= now)
	.sort((a, b) => new Date(a.data.start_date).getTime() - new Date(b.data.start_date).getTime());

const past = galleryExhibitions
	.filter((ex) => new Date(ex.data.end_date) < now)
	.sort((a, b) => new Date(b.data.end_date).getTime() - new Date(a.data.end_date).getTime());

const formatDate = (dateStr: string) => {
	const d = new Date(dateStr);
	return d.toLocaleDateString("cs-CZ", {
		day: "numeric",
		month: "numeric",
		year: "numeric",
	});
};

// Build a unique meta description per gallery (note excerpt, or address/district fallback)
const note = (gallery.data.note as string | undefined)?.replace(/\s+/g, " ").trim();
const districtLabel = districts[0]?.label;
const metaDescription =
	note && note.length > 0
		? note.length > 155
			? note.slice(0, 152).trimEnd() + "…"
			: note
		: `${gallery.data.title} — galerie na adrese ${gallery.data.address}${districtLabel ? `, ${districtLabel}` : ""}, Praha.`;

// Structured data: ArtGallery + current/upcoming exhibitions as ExhibitionEvent
const postalAddress = {
	"@type": "PostalAddress",
	streetAddress: gallery.data.address,
	addressLocality: "Praha",
	addressCountry: "CZ",
};
const galleryJsonLd = {
	"@context": "https://schema.org",
	"@type": "ArtGallery",
	name: gallery.data.title,
	...(seo.canonical ? { url: seo.canonical } : {}),
	...(gallery.data.web ? { sameAs: [gallery.data.web] } : {}),
	address: postalAddress,
	...(currentAndUpcoming.length > 0
		? {
				event: currentAndUpcoming.map((ex) => ({
					"@type": "ExhibitionEvent",
					name: ex.data.title,
					startDate: ex.data.start_date,
					endDate: ex.data.end_date,
					location: { "@type": "Place", name: gallery.data.title, address: postalAddress },
				})),
			}
		: {}),
};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description ?? metaDescription}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "galleries", id: gallery.data.id as string, slug }}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(galleryJsonLd)} />
	</Fragment>

	<div class="with-sidebar">
		<article class="block gallery-article">
			<div class="gallery-content">
				<div class="post-card-tags">
					{
						districts.map((d) => (
							<a href={`/obvod/${d.slug}`} class="tag-chip">
								{d.label}
							</a>
						))
					}
					{
						categories.map((c) => (
							<a href={`/kategorie/${c.slug}`} class="tag-chip">
								{c.label}
							</a>
						))
					}
				</div>

				<h1 {...gallery.edit.title}>
					{gallery.data.title}
				</h1>

				<div class="gallery-details">
					<div class="detail-item">
						<strong class="detail-label">Adresa</strong>
						<div class="address-row">
							<span {...gallery.edit.address} class="address-value">{gallery.data.address}</span>
							<a href={`https://mapy.cz/zakladni?q=${encodeURIComponent(gallery.data.address + ', Praha')}`} target="_blank" rel="noopener noreferrer" class="map-link">
								Ukázat na mapě &rarr;
							</a>
						</div>
					</div>

					{
						gallery.data.web && (
							<div class="detail-item">
								<strong class="detail-label">Webové stránky</strong>
								<a {...gallery.edit.web} href={gallery.data.web as string} target="_blank" rel="noopener noreferrer" class="web-link">
									{gallery.data.web}
								</a>
							</div>
						)
					}
				</div>

				{
					gallery.data.note && (
						<div class="gallery-note">
							<strong class="detail-label">Poznámka / Popis</strong>
							<p {...gallery.edit.note} class="note-text">
								{gallery.data.note}
							</p>
						</div>
					)
				}

				{
					(currentAndUpcoming.length > 0 || past.length > 0) && (
						<div class="gallery-exhibitions-container">
							{currentAndUpcoming.length > 0 && (
								<div class="exhibitions-group">
									<h2 class="exhibitions-group-title">Aktuální a plánované výstavy</h2>
									<ul class="exhibitions-list">
										{currentAndUpcoming.map((ex) => (
											<li>
												<div class="exhibition-item-header">
													<h3 {...ex.edit.title} class="exhibition-item-title">{ex.data.title}</h3>
													<span class="exhibition-item-date">
														{formatDate(ex.data.start_date)} – {formatDate(ex.data.end_date)}
													</span>
												</div>
											</li>
										))}
									</ul>
								</div>
							)}

							{past.length > 0 && (
								<div class="exhibitions-group">
									<h2 class="exhibitions-group-title">Proběhlé výstavy</h2>
									<ul class="exhibitions-list past-exhibitions">
										{past.map((ex) => (
											<li>
												<div class="exhibition-item-header">
													<h3 {...ex.edit.title} class="exhibition-item-title">{ex.data.title}</h3>
													<span class="exhibition-item-date">
														{formatDate(ex.data.start_date)} – {formatDate(ex.data.end_date)}
													</span>
												</div>
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					)
				}
			</div>
		</article>

		<Sidebar />
	</div>
</Base>

<style>
	.gallery-article {
		padding: 0;
		overflow: hidden;
	}

	.gallery-content {
		padding: 2.5rem;
	}

	.gallery-content .post-card-tags {
		margin-bottom: 2rem;
	}

	.gallery-content h1 {
		margin-bottom: 2rem;
	}

	.gallery-details {
		border-top: 1px solid var(--border-color);
		border-bottom: 1px solid var(--border-color);
		padding: 2rem 0;
		margin-bottom: 2rem;
	}

	.detail-item {
		margin-bottom: 1.5rem;
	}

	.detail-item:last-child {
		margin-bottom: 0;
	}

	.detail-label {
		text-transform: uppercase;
		font-family: var(--font-body), sans-serif;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		display: block;
		color: var(--muted-color);
		margin-bottom: 0.5rem;
		font-weight: 700;
	}

	.address-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 1rem;
	}

	.address-value {
		font-family: var(--font-heading), serif;
		font-size: 1.5rem;
		color: var(--text-color);
	}

	.map-link {
		font-family: var(--font-body), sans-serif;
		font-size: 0.85rem;
		text-decoration: underline;
		color: var(--text-color);
		font-weight: 500;
	}

	.web-link {
		font-family: var(--font-heading), serif;
		font-size: 1.5rem;
		text-decoration: underline;
		color: var(--text-color);
		word-break: break-all;
	}

	.gallery-note {
		margin-top: 2rem;
	}

	.note-text {
		font-size: 1.1rem;
		line-height: 1.7;
		white-space: pre-line;
		color: var(--text-color);
	}

	.gallery-exhibitions-container {
		margin-top: 3rem;
		border-top: 1px solid var(--border-color);
		padding-top: 2rem;
	}

	.exhibitions-group {
		margin-bottom: 2.5rem;
	}

	.exhibitions-group:last-child {
		margin-bottom: 0;
	}

	.exhibitions-group-title {
		font-family: var(--font-heading), serif;
		font-size: 1.4rem;
		text-transform: uppercase;
		margin-bottom: 1.5rem;
		font-weight: normal;
		color: var(--text-color);
	}

	.exhibitions-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.exhibitions-list li {
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 1rem;
	}

	.exhibitions-list li:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.exhibition-item-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.exhibition-item-title {
		font-family: var(--font-heading), serif;
		font-size: 1.2rem;
		margin: 0;
		font-weight: normal;
		color: var(--text-color);
	}

	.exhibition-item-date {
		font-family: var(--font-mono), monospace;
		font-size: 0.85rem;
		color: var(--muted-color);
		white-space: nowrap;
	}

	.past-exhibitions .exhibition-item-title {
		color: var(--muted-color);
	}
</style>
