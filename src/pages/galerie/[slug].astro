---
import { getEmDashEntry, getEntryTerms, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: gallery, cacheHint } = await getEmDashEntry("galleries", slug);

if (!gallery) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(gallery, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/galerie/${slug}`,
});

const categories = await getEntryTerms("galleries", gallery.data.id as string, "gallery_category");
const districts = await getEntryTerms("galleries", gallery.data.id as string, "district");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "galleries", id: gallery.data.id as string, slug }}
>
	<div class="with-sidebar">
		<article class="block" style="padding: 0; overflow: hidden;">
			<div style="padding: 2.5rem;">
				<div class="post-card-tags" style="margin-bottom: 2rem;">
					{
						districts.map((d) => (
							<a href={`/obvod/${d.slug}`} class="tag-chip">
								{d.label}
							</a>
						))
					}
					{
						categories.map((c) => (
							<a href={`/kategorie/${c.slug}`} class="tag-chip">
								{c.label}
							</a>
						))
					}
				</div>

				<h1 {...gallery.edit.title} style="margin-bottom: 2rem;">
					{gallery.data.title}
				</h1>

				<div style="border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color); padding: 2rem 0; margin-bottom: 2rem;">
					<div style="margin-bottom: 1.5rem;">
						<strong style="text-transform: uppercase; font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.08em; display: block; color: var(--muted-color); margin-bottom: 0.5rem; font-weight: 700;">Adresa</strong>
						<div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem;">
							<span {...gallery.edit.address} style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--text-color);">{gallery.data.address}</span>
							<a href={`https://mapy.cz/zakladni?q=${encodeURIComponent(gallery.data.address + ', Praha')}`} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-body); font-size: 0.85rem; text-decoration: underline; color: var(--text-color); font-weight: 500;">
								Ukázat na mapě &rarr;
							</a>
						</div>
					</div>

					{
						gallery.data.web && (
							<div>
								<strong style="text-transform: uppercase; font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.08em; display: block; color: var(--muted-color); margin-bottom: 0.5rem; font-weight: 700;">Webové stránky</strong>
								<a {...gallery.edit.web} href={gallery.data.web as string} target="_blank" rel="noopener noreferrer" style="font-family: var(--font-heading); font-size: 1.5rem; text-decoration: underline; color: var(--text-color); word-break: break-all;">
									{gallery.data.web}
								</a>
							</div>
						)
					}
				</div>

				{
					gallery.data.note && (
						<div style="margin-top: 2rem;">
							<strong style="text-transform: uppercase; font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 0.08em; display: block; color: var(--muted-color); margin-bottom: 0.5rem; font-weight: 700;">Poznámka / Popis</strong>
							<p {...gallery.edit.note} style="font-size: 1.1rem; line-height: 1.7; white-space: pre-line; color: var(--text-color);">
								{gallery.data.note}
							</p>
						</div>
					)
				}
			</div>
		</article>

		<Sidebar />
	</div>
</Base>
