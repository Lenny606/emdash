---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import GalleryList from "../components/GalleryList.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: galleries, cacheHint: galleriesCacheHint } = await getEmDashCollection("galleries", {
	status: "published",
});
Astro.cache.set(galleriesCacheHint);

const { entries: exhibitions, cacheHint: exhibitionsCacheHint } = await getEmDashCollection("exhibitions", {
	status: "published",
});
Astro.cache.set(exhibitionsCacheHint);

const sortedGalleries = galleries.toSorted((a, b) =>
	a.data.title.localeCompare(b.data.title, "cs")
);

// Batch query terms for all galleries
const galleryIds = sortedGalleries.map((g) => g.data.id);
const categoriesByEntry = galleryIds.length > 0
	? await getTermsForEntries("galleries", galleryIds, "gallery_category")
	: new Map();
const districtsByEntry = galleryIds.length > 0
	? await getTermsForEntries("galleries", galleryIds, "district")
	: new Map();

// Unique districts present among the listed galleries (for the filter bar)
const districtMap = new Map<string, string>();
for (const terms of districtsByEntry.values()) {
	for (const term of terms) {
		districtMap.set(term.slug, term.label);
	}
}
const availableDistricts = Array.from(districtMap, ([slug, label]) => ({ slug, label })).sort(
	(a, b) => a.label.localeCompare(b.label, "cs")
);

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());

const galleryByUlid = new Map(galleries.map((g) => [g.data.id, g]));

// Filter and sort/limit exhibitions to active ones
const now = new Date();
const currentExhibitions = exhibitions
	.filter((ex) => {
		const start = new Date(ex.data.start_date);
		const end = new Date(ex.data.end_date);
		return start <= now && end >= now;
	})
	.slice(0, 5);

const formatDate = (dateStr: string) => {
	const d = new Date(dateStr);
	return d.toLocaleDateString("cs-CZ", {
		day: "numeric",
		month: "numeric",
		year: "numeric",
	});
};
---

<Base title={`${siteTitle} — galerie a výstavy současného umění v Praze`} pageTitle={siteTitle} description={siteTagline}>
	<h1 class="page-heading">ARTIS PRAGA</h1>

	<section class="exhibitions-section">
		<h2 class="section-title">Aktuální výstavy</h2>
		{
			currentExhibitions.length === 0 ? (
				<p class="no-exhibitions">Momentálně neprobíhají žádné výstavy.</p>
			) : (
				<ul class="exhibitions-list">
					{currentExhibitions.map((ex) => {
						const linkedGallery = galleryByUlid.get(ex.data.gallery);
						return (
							<li>
								<div class="exhibition-info">
									<h3 {...ex.edit.title}>
										{ex.data.title}
									</h3>
									{linkedGallery && (
										<p class="gallery-link-container">
											<a href={`/galerie/${linkedGallery.id}`}>
												{linkedGallery.data.title}
											</a>
										</p>
									)}
								</div>
								<div class="exhibition-date">
									{formatDate(ex.data.start_date)} – {formatDate(ex.data.end_date)}
								</div>
							</li>
						);
					})}
				</ul>
			)
		}
	</section>

	<section class="galleries-section">
		<h2 class="section-title">Seznam galerií</h2>

		{
			availableDistricts.length > 0 && (
				<div class="district-filter" id="district-filter" role="group" aria-label="Filtrovat podle lokality">
					<button type="button" class="district-filter-chip is-active" data-district="all" aria-pressed="true">
						Vše
					</button>
					{availableDistricts.map((d) => (
						<button type="button" class="district-filter-chip" data-district={d.slug} aria-pressed="false">
							{d.label}
						</button>
					))}
				</div>
			)
		}

		<p class="district-filter-empty" id="district-filter-empty" hidden>
			V této lokalitě zatím nejsou žádné galerie.
		</p>

		<GalleryList
			galleries={sortedGalleries}
			categoriesByEntry={categoriesByEntry}
			districtsByEntry={districtsByEntry}
		>
			<Fragment slot="empty">
				<p>
					Zatím žádné galerie.{" "}
					<a href="/_emdash/admin/content/galleries/new">VYTVOŘTE PRVNÍ</a>.
				</p>
			</Fragment>
		</GalleryList>
	</section>
</Base>

<style>
	.exhibitions-section {
		margin-bottom: 4rem;
	}

	.section-title {
		font-family: var(--font-heading), serif;
		font-size: clamp(1.8rem, 4vw, 2.5rem);
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 0.5rem;
		text-transform: uppercase;
	}

	.no-exhibitions {
		color: var(--muted-color);
		font-style: italic;
	}

	.exhibitions-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding: 0;
		margin-bottom: 3rem;
		list-style: none;
	}

	.exhibitions-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 1rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.exhibition-info {
		flex-grow: 1;
		min-width: min(280px, 100%);
	}

	.exhibitions-list h3 {
		font-family: var(--font-heading), serif;
		font-size: 1.3rem;
		margin: 0 0 0.25rem 0;
		font-weight: normal;
	}

	.gallery-link-container {
		font-family: var(--font-body), sans-serif;
		font-size: 0.9rem;
		color: var(--muted-color);
		margin: 0;
	}

	.gallery-link-container a {
		text-decoration: underline;
	}

	.exhibition-date {
		font-family: var(--font-mono), monospace;
		font-size: 0.9rem;
		color: var(--muted-color);
		white-space: nowrap;
	}

	.district-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.district-filter-chip {
		font-family: var(--font-body), sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.5rem 0.9rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		color: var(--text-color);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.district-filter-chip:hover {
		border-color: var(--border-primary);
		background: var(--bg-color);
	}

	.district-filter-chip.is-active {
		background: var(--text-color);
		color: var(--bg-color);
		border-color: var(--text-color);
	}

	.district-filter-empty {
		color: var(--muted-color);
		font-style: italic;
	}

	:global(.post-list .post-card[hidden]) {
		display: none;
	}
</style>

<script is:inline>
	(() => {
		const filter = document.getElementById("district-filter");
		if (!filter) return;
		const chips = filter.querySelectorAll(".district-filter-chip");
		const cards = document.querySelectorAll(".post-list .post-card");
		const empty = document.getElementById("district-filter-empty");

		filter.addEventListener("click", (e) => {
			const chip = e.target.closest(".district-filter-chip");
			if (!chip) return;

			const district = chip.dataset.district;
			chips.forEach((c) => {
				const active = c === chip;
				c.classList.toggle("is-active", active);
				c.setAttribute("aria-pressed", String(active));
			});

			let visible = 0;
			cards.forEach((card) => {
				const districts = (card.dataset.districts || "").split(" ").filter(Boolean);
				const show = district === "all" || districts.includes(district);
				card.hidden = !show;
				if (show) visible++;
			});

			if (empty) empty.hidden = visible !== 0;
		});
	})();
</script>
