---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<h1 style="margin-bottom: 3rem; background: var(--accent-3); display: inline-block; padding: 0.5rem 1rem; border: var(--border-width) solid var(--border-color); box-shadow: var(--shadow-offset) var(--shadow-offset) 0px var(--shadow-color);">RECENT POSTS</h1>

	{
		posts.length === 0 ? (
			<div class="block">
				<p>
					No posts yet.{" "}
					<a href="/_emdash/admin/content/posts/new">CREATE ONE</a>.
				</p>
			</div>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-card">
						<a href={`/posts/${post.id}`} style="display: block; height: 100%;">
							{post.data.featured_image && (
								<div class="image-wrapper">
									<Image image={post.data.featured_image} />
								</div>
							)}
							<div class="content">
								{post.data.publishedAt && (
									<time datetime={post.data.publishedAt.toISOString()}>
										{post.data.publishedAt.toLocaleDateString("en-US", {
											year: "numeric",
											month: "long",
											day: "numeric",
										})}
									</time>
								)}
								<h2>{post.data.title}</h2>
								{post.data.excerpt && <p style="font-weight: 500;">{post.data.excerpt}</p>}
								<div style="margin-top: 1.5rem; font-weight: 900; text-decoration: underline;">READ MORE &rarr;</div>
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
</Base>
