---
import { getEmDashEntry, getEntryTerms, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import Image from "../../components/Image.astro";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";
import { formatDate } from "../../utils/format";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: `/posts/${slug}`,
});

// Taxonomy terms for this post (use post.data.id, not post.id)
const tags = await getEntryTerms("posts", post.data.id, "tag");
const categories = await getEntryTerms("posts", post.data.id, "category");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="with-sidebar">
		<article class="block" style="padding: 0; overflow: hidden;">
					<div {...post.edit.featured_image} class="image-wrapper" style="border-bottom: var(--border-width) solid var(--border-color);">
						<Image image={post.data.featured_image} />
					</div>

			<div style="padding: 2.5rem;">
				<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 2rem;">
					{
						post.data.publishedAt && (
							<time datetime={post.data.publishedAt.toISOString()} style="font-family: var(--font-mono); font-weight: bold; background: var(--accent-3); padding: 0.25rem 0.75rem; border: 2px solid var(--border-color);">
								{formatDate(post.data.publishedAt)}
							</time>
						)
					}
					{
						categories.length > 0 && (
							<div style="display: flex; gap: 0.5rem;">
								{categories.map((c) => (
									<a href={`/category/${c.slug}`} style="background: var(--accent-1); padding: 0.25rem 0.75rem; border: 2px solid var(--border-color); font-size: 0.8rem; text-transform: uppercase;">{c.label}</a>
								))}
							</div>
						)
					}
				</div>

				<h1 {...post.edit.title} style="font-size: 4rem; margin-bottom: 2rem; line-height: 1;">{post.data.title}</h1>

				<div class="portable-text">
					<PortableText value={post.data.content} />
				</div>

				{
					tags.length > 0 && (
						<div style="margin-top: 4rem; padding-top: 2rem; border-top: 2px dashed var(--border-color); display: flex; gap: 0.75rem; align-items: center;">
							<span style="font-weight: 900; text-transform: uppercase;">Štítky:</span>
							{tags.map((t) => (
								<a href={`/tag/${t.slug}`} style="background: var(--accent-2); padding: 0.1rem 0.5rem; border: 2px solid var(--border-color); font-size: 0.9rem;">#{t.label}</a>
							))}
						</div>
					)
				}
			</div>
		</article>

		<Sidebar />
	</div>
</Base>
