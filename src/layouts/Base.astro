---
import { getMenu, getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { LEGAL, legalHref } from "../config/legal.ts";
import "../styles/global.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Emit <meta name="robots" content="noindex, nofollow">. Defaults to true — the whole site is kept out of search indexes. */
	noindex?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, noindex = true, content } = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

// Default every page to a self-referencing canonical (without query string)
// so listings/archives are covered too. Content pages may override via props.
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: resolvedCanonical,
	image,
	content,
	siteName: siteTitle,
	seo: noindex ? { robots: "noindex, nofollow" } : undefined,
});
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#111111" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<title>{fullTitle}</title>
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} — RSS`} href="/rss.xml" />
		{/* description + canonical are emitted by <EmDashHead> from the page context */}
		<EmDashHead page={pageCtx} />
		<slot name="head" />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header>
			<nav>
				<a href="/" class="logo-link">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: <span>{siteTitle}</span>
					}
				</a>
				<button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
					MENU
				</button>
				<div class="nav-links" id="nav-links">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="search-container">
					<LiveSearch placeholder="HLEDAT..." collections={["galleries", "pages"]} />
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-container">
				<div class="footer-branding">
					<a href="/" class="footer-logo">
						{siteLogo
							? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
							: <span>{siteTitle}</span>
						}
					</a>
					{siteTagline && <p class="footer-tagline">{siteTagline}</p>}
				</div>
				<nav class="footer-legal" aria-label="Právní informace">
					<a href={legalHref("terms")}>Obchodní podmínky</a>
					<a href={legalHref("privacy")}>Ochrana osobních údajů</a>
					<a href={legalHref("complaints")}>Reklamační řád</a>
					<a href={legalHref("withdrawal")}>Odstoupení od smlouvy</a>
				</nav>
			</div>
			<div class="footer-bottom">
				<div class="footer-container">
					<p class="footer-seller">
						{LEGAL.seller.name} · IČO: {LEGAL.seller.ico} · {LEGAL.vatPayer ? `DIČ: ${LEGAL.seller.dic}` : "Neplátce DPH"}<br />
						{LEGAL.seller.address} · {LEGAL.seller.email}
					</p>
					<p>&copy; {new Date().getFullYear()} {siteTitle}. VŠECHNA PRÁVA VYHRAZENA.</p>
				</div>
			</div>
		</footer>

		<div class="cookie-bar" id="cookie-bar" hidden role="dialog" aria-label="Souhlas s cookies">
			<p class="cookie-bar__text">
				Používáme nezbytné cookies pro fungování webu a volitelné cookies pro
				analýzu. Více v <a href={legalHref("privacy")}>zásadách zpracování osobních údajů</a>.
			</p>
			<div class="cookie-bar__actions">
				<button type="button" data-cookie="reject" class="cookie-bar__btn cookie-bar__btn--ghost">Jen nezbytné</button>
				<button type="button" data-cookie="accept" class="cookie-bar__btn">Přijmout vše</button>
			</div>
		</div>

		<EmDashBodyEnd page={pageCtx} />

		<script is:inline>
			// Handle Enter key in the search input to redirect to the search page
			document.addEventListener("keydown", (e) => {
				if (e.key === "Enter" && e.target.closest(".search-container")) {
					const input = e.target;
					const query = (input.value || "").trim();
					if (query) {
						window.location.href = `/search?q=${encodeURIComponent(query)}`;
					}
				}
			});

			// Mobile menu toggle
			const menuToggle = document.getElementById("menu-toggle");
			const navLinks = document.getElementById("nav-links");

			if (menuToggle && navLinks) {
				menuToggle.addEventListener("click", () => {
					navLinks.classList.toggle("active");
					menuToggle.textContent = navLinks.classList.contains("active") ? "ZAVŘÍT" : "MENU";
				});
			}

			// Cookie consent. Stored in localStorage as "accepted" | "rejected".
			// Non-essential scripts should check window.__cookieConsent === "accepted"
			// (or listen for the "cookie-consent" event) before loading.
			(function () {
				const KEY = "cookie-consent";
				const bar = document.getElementById("cookie-bar");
				const saved = localStorage.getItem(KEY);
				window.__cookieConsent = saved || "pending";
				if (!saved && bar) bar.hidden = false;
				function choose(value) {
					localStorage.setItem(KEY, value);
					window.__cookieConsent = value;
					if (bar) bar.hidden = true;
					document.dispatchEvent(new CustomEvent("cookie-consent", { detail: value }));
				}
				bar?.querySelectorAll("[data-cookie]").forEach((btn) => {
					btn.addEventListener("click", () => {
						choose(btn.getAttribute("data-cookie") === "accept" ? "accepted" : "rejected");
					});
				});
			})();
		</script>
	</body>
</html>

<style>
	.footer-legal {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		margin-top: 1rem;
	}
	.footer-legal a {
		font-size: 0.85rem;
		opacity: 0.85;
	}
	.footer-seller {
		font-size: 0.8rem;
		opacity: 0.7;
		margin: 0 0 0.5rem;
		line-height: 1.5;
	}
	.cookie-bar {
		position: fixed;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		max-width: 48rem;
		margin: 0 auto;
		background: #1a1a1a;
		color: #fff;
		border-radius: 0.75rem;
		padding: 1rem 1.25rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
		z-index: 1000;
	}
	.cookie-bar[hidden] { display: none; }
	.cookie-bar__text { margin: 0; font-size: 0.85rem; flex: 1 1 16rem; line-height: 1.5; }
	.cookie-bar__text a { color: #fff; text-decoration: underline; }
	.cookie-bar__actions { display: flex; gap: 0.5rem; }
	.cookie-bar__btn {
		cursor: pointer;
		border: 0;
		border-radius: 0.4rem;
		padding: 0.5rem 1rem;
		font-size: 0.85rem;
		background: #fff;
		color: #1a1a1a;
	}
	.cookie-bar__btn--ghost { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.4); }

	.logo-link img {
		height: 48px;
		width: auto;
		display: block;
	}
</style>
