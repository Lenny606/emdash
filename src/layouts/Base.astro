---
import { getMenu, getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/global.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Emit <meta name="robots" content="noindex, nofollow">. Defaults to true — the whole site is kept out of search indexes. */
	noindex?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, noindex = true, content } = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

// Default every page to a self-referencing canonical (without query string)
// so listings/archives are covered too. Content pages may override via props.
const resolvedCanonical = canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: resolvedCanonical,
	image,
	content,
	siteName: siteTitle,
	seo: noindex ? { robots: "noindex, nofollow" } : undefined,
});
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#111111" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<title>{fullTitle}</title>
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} — RSS`} href="/rss.xml" />
		{/* description + canonical are emitted by <EmDashHead> from the page context */}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header>
			<nav>
				<a href="/" class="logo-link">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} style="height:48px;width:auto;display:block;" />
						: <span>{siteTitle}</span>
					}
				</a>
				<button class="menu-toggle" id="menu-toggle" aria-label="Toggle Menu">
					MENU
				</button>
				<div class="nav-links" id="nav-links">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>
				<div class="search-container">
					<LiveSearch placeholder="HLEDAT..." collections={["galleries", "pages"]} />
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-container">
				<div class="footer-branding">
					<a href="/" class="footer-logo">
						{siteLogo
							? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
							: <span>{siteTitle}</span>
						}
					</a>
					{siteTagline && <p class="footer-tagline">{siteTagline}</p>}
				</div>
			</div>
			<div class="footer-bottom">
				<div class="footer-container">
					<p>&copy; {new Date().getFullYear()} {siteTitle}. VŠECHNA PRÁVA VYHRAZENA.</p>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />

		<script is:inline>
			// Handle Enter key in the search input to redirect to the search page
			document.addEventListener("keydown", (e) => {
				if (e.key === "Enter" && e.target.closest(".search-container")) {
					const input = e.target;
					const query = (input.value || "").trim();
					if (query) {
						window.location.href = `/search?q=${encodeURIComponent(query)}`;
					}
				}
			});

			// Mobile menu toggle
			const menuToggle = document.getElementById("menu-toggle");
			const navLinks = document.getElementById("nav-links");

			if (menuToggle && navLinks) {
				menuToggle.addEventListener("click", () => {
					navLinks.classList.toggle("active");
					menuToggle.textContent = navLinks.classList.contains("active") ? "ZAVŘÍT" : "MENU";
				});
			}
		</script>
	</body>
</html>
